# Обязательные настройки
DEVBOARD_PASSWORD=change-me
DEVBOARD_SECRET_KEY=change-me-to-a-long-random-string
GITHUB_TOKEN=ghp_replace_me
GITHUB_REPO=Evgen-rus/Dev_tasks

# Доступ для coding agents (CLI / HTTP). Если пусто — используется DEVBOARD_PASSWORD.
DEVBOARD_API_TOKEN=

# Необязательные
DEVBOARD_ID_PREFIX=DEV
DEVBOARD_COOKIE_SECURE=false
DEVBOARD_PORT=8080
STORAGE_DIR=/data/storage

# Транскрибация. Если ключ не задан, задачи всё равно сохраняются, но без расшифровки.
OPENAI_API_KEY=
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
OPENAI_TRANSCRIBE_LANGUAGE=ru

# Проекты, которые создаются как GitHub labels при первом запуске.
DEVBOARD_DEFAULT_PROJECTS=NeuroROP,LeadRecord,AgentBridge,NeuroHR,Other
